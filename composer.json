{
	"name": "josephgabito/kilobyte-image-optimizer",
	"description": "Unlimited free image compression, WebP & AVIF conversion, resize, and thumbnail regeneration in your browser.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"squizlabs/php_codesniffer": "^3.11",
		"wp-coding-standards/wpcs": "^3.1",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"wp-phpunit/wp-phpunit": "~7.1.0"
	},
	"autoload": {
		"psr-4": {
			"Kilobyte\\ImageOptimizer\\": "src/"
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist",
		"test": "phpunit --no-coverage",
		"test:coverage": "@php -d pcov.enabled=1 -d pcov.directory=. -d \"pcov.exclude=~/(vendor|\\.cache|tests|node_modules)/~\" vendor/bin/phpunit"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.0"
		}
	}
}
